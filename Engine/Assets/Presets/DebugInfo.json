{
    ".name": "_",
    "SetScreenPosition": [0, 0, 10, 10],
    "SetScreenSize": [0.1, 0.3, 0, 0],
    "SetVisibility": true,
    "elements": {
        "BoxElement-instances": [
            {
                ".name": "BG",
                ".parent": "this",
                "SetScreenSize": [1, 1, 0, 0],
                "BorderWeight": 1,
                "BorderColor": [0, 0, 0, 255]
            }
        ],
        "ResizeElement-instances": [
            {
                ".name": "ResizeElement",
                ".parent": "this",
                "ResizeTarget": "BG",
                "padding": 2
            }
        ],
        "TextElement-instances": [
            {
                ".name": "PlayerPosText",
                ".parent": "this",
                "SetTextMode": "ResizeToFit",
                "SetWrapText": false,
                "SetPtSize": 16,
                "SetZIndex": 1
            },
            {
                ".name": "FPSText",
                ".parent": "this",
                "SetText": "FPS: 2 millioN!",
                "SetFont": "Opsilon.ttf",
                "SetScreenPosition": [0, 0, 0, 10],
                "SetTextMode": "ResizeToFit",
                "SetWrapText": false,
                "SetPtSize": 16,
                "SetZIndex": 1
            }
        ]
    }
}