{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://powatos.github.io/PotatoEnginev2/Presets.schema.json",
    "title": "Widget Preset",
    "description": "Widget presets for Potato Engine v2",
    "$ref": "#/$defs/UIElement",
    "unevaluatedProperties": false,
    "properties": {
        ".name" : {
            "type": "string",
            "description": "This property is obsolete at the top-level"
        },
        "elements": {
            "type": "object",
            "additionalProperties": false,
            "$comment": "Add new element types here with matching definition",
            "properties": {
                "BoxElement-instances": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/BoxElement"
                    }
                },
                "TextElement-instances": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/TextElement"
                    }
                },
                "ResizeElement-instances": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/ResizeElement"
                    }
                }
            }
        }
    },
    "$defs": {
        "UIVector": {
            "type": "array",
            "items": {
                "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
        },
        "Color": {
            "type": "array",
            "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
            },
            "minItems": 4,
            "maxItems": 4
        },
        "UIElement": {
            "type": "object",
            "required": [".name"],
            "properties": {
                ".name": {
                    "type": "string"
                },
                "SetScreenSize": {
                    "$ref": "#/$defs/UIVector"
                },
                "SetScreenPosition": {
                    "$ref": "#/$defs/UIVector"
                },
                "SetVisibility": {
                    "type": "boolean"
                },
                "SetZIndex": {
                    "type": "integer",
                    "minimum": 1
                }
            }
        },
        "WidgetElement": {
            "$ref": "#/$defs/UIElement",
            "required": [".parent"],
            "properties": {
                ".parent": {
                    "type": "string"
                }
            }
        },
        "BoxElement": {
            "$ref": "#/$defs/WidgetElement",
            "unevaluatedProperties": false,
            "properties": {
                "FillColor": {
                    "$ref": "#/$defs/Color"
                },
                "BorderColor": {
                    "$ref": "#/$defs/Color"
                },
                "BorderWeight": {
                    "type": "integer",
                    "minimum": 0
                }
            }
        },
        "TextElement": {
            "$ref": "#/$defs/WidgetElement",
            "unevaluatedProperties": false,
            "properties": {
                "SetText": {
                    "type": "string"
                },
                "SetWrapText": {
                    "type": "boolean"
                },
                "SetTextMode": {
                    "type": "string",
                    "enum": ["ResizeToFit", "ShrinkToFit", "IgnoreBounds"]
                },
                "SetFont": {
                    "type": "string"
                },
                "SetColor": {
                    "$ref": "#/$defs/Color"
                },
                "SetPtSize": {
                    "type": "integer",
                    "minimum": 1
                }
            }
        },
        "ResizeElement": {
            "$ref": "#/$defs/WidgetElement",
            "unevaluatedProperties": false,
            "properties": {
                "ResizeTarget": {
                    "type": "string"
                },
                "padding": {
                    "type": "integer"
                }
            }
        }

    }


}

























